        "semantic_body": [
          "void PauseUi_UpdateDualAlpha(uint32_t unused, PauseUiDualAlphaState* state) {",
          "    if (PauseContext_GetState() != 0) return;",
          "    if (state->gateTimer != 0 && --state->gateTimer != 0) return;",
          "    const int16_t updateRate = gOot3dUpdateContext->updateRate;",
          "    const bool fadeIn = state->fadeTimer != 0 && --state->fadeTimer != 0;",
          "    const float primaryFactor = fadeIn ? 3.3333335f : 10.0f;",
          "    const float secondaryFactor = fadeIn ? 6.666667f : 23.333334f;",
          "    const int16_t target = fadeIn ? 255 : 0;",
          "    Math_StepToS(&state->primaryAlpha, target, (int16_t)(0.5f + updateRate * primaryFactor));",
          "    Math_StepToS(&state->secondaryAlpha, target, (int16_t)(0.5f + updateRate * secondaryFactor));",
          "}"
        ],
        "required_assertions": [
          "the state pointer is supplied in r1 rather than r0",
          "timer stores are exactly 8-bit at offsets 0x10 and 0x11",
          "alpha values are exactly signed 16-bit at offsets 0x12 and 0x14",
          "updateRate is a signed halfword at offset 0x110 from the object reached through pointer cell 0x0051B2F4",
          "the six literal-pool words and VFP conversion order remain target-identical",
          "PauseContext_GetState runs before either timer is read",
          "the second Math_StepToS remains equivalent to the observed tail call"
        ],
        "notes": [
